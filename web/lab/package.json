{
  "name": "mxlpy-lab",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@computational-biology-aachen/design": "github:Computational-Biology-Aachen/design",
    "@eslint/compat": ">=2.1.1",
    "@eslint/js": ">=10.0.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": ">=4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/load-config": ">=0.2.2",
    "@sveltejs/vite-plugin-svelte": ">=7.3.1",
    "@types/node": "^26.6.5",
    "chart.js": ">=4.5.0",
    "eslint": ">=10.12.0",
    "eslint-config-prettier": ">=10.1.8",
    "eslint-plugin-svelte": ">=3.24.1",
    "globals": ">=17.14.0",
    "prettier": ">=3.9.10",
    "prettier-plugin-css-order": ">=2.2.0",
    "prettier-plugin-svelte": ">=4.1.1",
    "svelte": ">=5.57.3",
    "svelte-check": ">=4.7.8",
    "typescript": ">=6.0.3",
    "typescript-eslint": ">=8.73.0",
    "vite": ">=8.3.7",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "eslint": "$eslint"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
